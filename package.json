{
  "name": "nexus-explorer",
  "version": "0.1.0",
  "description": "A next-generation file explorer with AI capabilities",
  "main": "build/electron.js",
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "postbuild": "node scripts/copy-electron.js",
    "build:win": "npm run build && npx electron-builder --win --publish never",
    "dev": "concurrently \"cross-env BROWSER=none craco start\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "start:react": "npx craco start",
    "build:linux": "npx craco build && npx electron-builder --linux"
  },
  "keywords": [
    "file-explorer",
    "electron",
    "react",
    "ai",
    "productivity"
  ],
  "author": "Nexus Explorer Team",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "11.11.0",
    "@emotion/styled": "11.11.0",
    "@mui/icons-material": "5.11.0",
    "@mui/material": "5.11.0",
    "chokidar": "3.5.3",
    "electron-store": "8.1.0",
    "electron-updater": "5.0.0",
    "fs-extra": "10.0.0",
    "mime-types": "2.1.35",
    "path-browserify": "1.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.3.0",
    "react-window": "1.8.7"
  },
  "devDependencies": {
    "@babel/core": "7.17.0",
    "@babel/plugin-transform-typescript": "^7.28.0",
    "@babel/preset-env": "7.16.11",
    "@babel/preset-react": "7.16.7",
    "@babel/preset-typescript": "^7.27.1",
    "@craco/craco": "7.1.0",
    "concurrently": "^7.0.0",
    "cross-env": "7.0.3",
    "electron": "^19.0.0",
    "electron-builder": "^23.0.3",
    "electron-is-dev": "^3.0.1",
    "react-scripts": "5.0.1",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "wait-on": "^6.0.1"
  },
  "build": {
    "appId": "com.nexus.explorer",
    "productName": "Nexus Explorer",
    "copyright": "Copyright © 2025 Nexus Explorer",
    "directories": {
      "output": "dist",
      "buildResources": "public",
      "app": "build"
    },
    "files": [
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": ["**/*", "!electron.js"]
      }
    ],
    "asar": true,
    "extends": null,
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "extraResources": [
        {
          "from": "public/icon.ico",
          "to": "icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus Explorer"
    },
    "publish": {
      "provider": "github",
      "owner": "your-github-username",
      "repo": "nexus-explorer"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
